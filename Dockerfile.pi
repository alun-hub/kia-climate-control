# Optimerad Dockerfile för Raspberry Pi Zero 2W
# Använd Alpine Linux för minimal minnesfotavtryck
FROM python:3.11-alpine

# Set working directory
WORKDIR /app

# Install system dependencies (Alpine använder apk istället för apt-get)
# gcc och musl-dev behövs för att kompilera vissa Python-paket
# tzdata för tidszon-support
RUN apk add --no-cache gcc musl-dev tzdata

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY kia_backend.py .
COPY public/ ./public/

# Create directory for schedules
RUN mkdir -p /app/data

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=5000
ENV TZ=Europe/Stockholm

# Expose port
EXPOSE 5000

# Health check (längre intervall för Pi Zero 2W)
HEALTHCHECK --interval=60s --timeout=15s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/api/health')"

# Run the application
CMD ["python", "kia_backend.py"]
